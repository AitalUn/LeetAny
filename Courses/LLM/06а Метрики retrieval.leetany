{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-06",
      "title": "Метрики retrieval",
      "statement": "Удали дубли ranked с сохранением порядка, возьми первые k. relevant — множество ID независимо от дублей. Верни precision, recall, rr. precision=число найденных релевантных/k, даже если результатов меньше k. recall=найденные/число relevant, при пустом relevant — 0. rr=1/позиция первого релевантного в top-k, либо 0. k — int>0, иначе ValueError; bool недопустим. Возвращаемые ключи ровно precision, recall, rr.",
      "example": "([\"x\", \"a\", \"b\"], [\"a\", \"b\", \"c\"], 2) → {\"precision\": 0.5, \"recall\": 1/3, \"rr\": 0.5}",
      "entry": "retrieval_metrics",
      "starter": "def retrieval_metrics(ranked: list[str], relevant: list[str], k: int) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              "x",
              "a",
              "b"
            ],
            [
              "a",
              "b",
              "c"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 0.3333333333333333,
            "rr": 0.5
          }
        },
        {
          "args": [
            [
              "a",
              "a",
              "b"
            ],
            [
              "a",
              "b"
            ],
            2
          ],
          "expected": {
            "precision": 1.0,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [
              "a"
            ],
            [
              "a"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [],
            [],
            2
          ],
          "expected": {
            "precision": 0.0,
            "recall": 0.0,
            "rr": 0.0
          }
        },
        {
          "args": [
            [],
            [],
            0
          ],
          "error": "ValueError"
        }
      ]
    }
  ]
}
