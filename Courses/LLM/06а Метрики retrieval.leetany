{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-06",
      "title": "Метрики retrieval",
      "statement": "Удали дубли ranked с сохранением порядка, возьми первые k. relevant — множество ID независимо от дублей. Верни precision, recall, rr. precision=число найденных релевантных/k, даже если результатов меньше k. recall=найденные/число relevant, при пустом relevant — 0. rr=1/позиция первого релевантного в top-k, либо 0. k — int>0, иначе ValueError; bool недопустим. Возвращаемые ключи ровно precision, recall, rr.",
      "example": "([\"x\", \"a\", \"b\"], [\"a\", \"b\", \"c\"], 2) → {\"precision\": 0.5, \"recall\": 1/3, \"rr\": 0.5}",
      "entry": "retrieval_metrics",
      "starter": "def retrieval_metrics(ranked: list[str], relevant: list[str], k: int) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              "x",
              "a",
              "b"
            ],
            [
              "a",
              "b",
              "c"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 0.3333333333333333,
            "rr": 0.5
          }
        },
        {
          "args": [
            [
              "a",
              "a",
              "b"
            ],
            [
              "a",
              "b"
            ],
            2
          ],
          "expected": {
            "precision": 1.0,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [
              "a"
            ],
            [
              "a"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [],
            [],
            2
          ],
          "expected": {
            "precision": 0.0,
            "recall": 0.0,
            "rr": 0.0
          }
        },
        {
          "args": [
            [],
            [],
            0
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "easy",
      "lesson": "06 Метрики retrieval.md",
      "editorial": {
        "explanation": "Сначала убери повторы из выдачи и возьми первые k позиций. Точность делится на k, полнота — на число эталонных документов. Для reciprocal rank нужна позиция первого попадания.",
        "code": "def retrieval_metrics(ranked, relevant, k):\n    if type(k) is not int or k <= 0:\n        raise ValueError(\"k должен быть положительным\")\n    target = set(relevant)\n    top = list(dict.fromkeys(ranked))[:k]\n    hits = [i for i, doc in enumerate(top, 1) if doc in target]\n    return {\"precision\": len(hits) / k,\n            \"recall\": len(hits) / len(target) if target else 0,\n            \"rr\": 1 / hits[0] if hits else 0}"
      }
    }
  ]
}
