{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-09",
      "title": "Paired bootstrap",
      "statement": "deltas — непустой список конечных попарных разностей; n_samples — int>0 (без bool), seed — int. Иначе ValueError. Используй rng=random.Random(seed). Для каждого bootstrap-повтора выбирай len(deltas) индексов через rng.randrange(len(deltas)), вычисляй среднее. Отсортируй средние. low/high — nearest-rank 2.5% и 97.5%: индекс max(0,ceil(p*n_samples)-1). mean — среднее исходных deltas. Верни mean, low, high. Это учебный percentile-интервал, не готовая проверка статистической значимости.",
      "example": "([1, 1], 100, 42) → {\"mean\":1.0,\"low\":1.0,\"high\":1.0}",
      "entry": "paired_bootstrap",
      "starter": "def paired_bootstrap(deltas: list[float], n_samples: int, seed: int) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1,
              1
            ],
            100,
            42
          ],
          "expected": {
            "mean": 1.0,
            "low": 1.0,
            "high": 1.0
          }
        },
        {
          "args": [
            [
              -1,
              1,
              2
            ],
            200,
            42
          ],
          "expected": {
            "mean": 0.6666666666666666,
            "low": -1.0,
            "high": 2.0
          }
        },
        {
          "args": [
            [
              0
            ],
            5,
            0
          ],
          "expected": {
            "mean": 0.0,
            "low": 0.0,
            "high": 0.0
          }
        },
        {
          "args": [
            [],
            10,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1
            ],
            0,
            0
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "medium",
      "lesson": "09 Статистика экспериментов.md",
      "editorial": {
        "explanation": "Единица повторной выборки — разность на одном и том же объекте. В каждом повторе набери столько же разностей с возвращением, затем возьми границы из отсортированных средних.",
        "code": "import math\nimport random\nfrom statistics import mean\n\ndef paired_bootstrap(deltas, n_samples, seed):\n    if (not deltas or type(n_samples) is not int or n_samples <= 0\n            or type(seed) is not int or any(type(x) not in (int, float)\n            or not math.isfinite(x) for x in deltas)):\n        raise ValueError(\"Некорректные параметры bootstrap\")\n    rng = random.Random(seed)\n    n = len(deltas)\n    samples = sorted(mean(deltas[rng.randrange(n)] for _ in range(n))\n                     for _ in range(n_samples))\n    def quantile(p):\n        return samples[max(0, math.ceil(p * n_samples) - 1)]\n    return {\"mean\": mean(deltas), \"low\": quantile(.025), \"high\": quantile(.975)}"
      }
    }
  ]
}
