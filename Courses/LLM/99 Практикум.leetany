{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-01",
      "title": "Бюджет контекста",
      "statement": "token_counts — уже посчитанные количества токенов сообщений; индекс 0 — обязательное системное сообщение. Верни индекс 0 и самый длинный непрерывный суффикс остальных сообщений, помещающийся вместе с ним и reserve в limit. Иди от последнего сообщения назад; если очередное не помещается — остановись, более старые не подбирай. Не меняй вход. Если token_counts пуст — верни []. Числа — неотрицательные int (bool не принимается); отрицательные значения/не-int или обязательное сообщение+reserve>limit дают ValueError. Для пустого списка reserve>limit тоже ошибка.",
      "example": "([4, 6, 3, 2], 12, 2) → [0, 2, 3]",
      "entry": "select_context",
      "starter": "def select_context(token_counts: list[int], limit: int, reserve: int) -> list[int]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              4,
              6,
              3,
              2
            ],
            12,
            2
          ],
          "expected": [
            0,
            2,
            3
          ]
        },
        {
          "args": [
            [
              4,
              6,
              3,
              2
            ],
            20,
            2
          ],
          "expected": [
            0,
            1,
            2,
            3
          ]
        },
        {
          "args": [
            [],
            5,
            0
          ],
          "expected": []
        },
        {
          "args": [
            [
              4,
              10,
              2
            ],
            6,
            0
          ],
          "expected": [
            0,
            2
          ]
        },
        {
          "args": [
            [
              4,
              1
            ],
            3,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1,
              -1
            ],
            10,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              true
            ],
            5,
            0
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-02",
      "title": "Устойчивый softmax",
      "statement": "Верни вероятности softmax(logits/temperature). Используй численно устойчивое вычисление. [] даёт []; temperature должен быть конечным числом >0, logits должны быть конечными числами; bool не считается числом. Иначе ValueError. Сумма вероятностей близка к 1, исходный список не меняется. Абсолютная погрешность тестов 1e-8.",
      "example": "([1000, 1000], 1) → [0.5, 0.5]",
      "entry": "softmax",
      "starter": "def softmax(logits: list[float], temperature: float) -> list[float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1000,
              1000
            ],
            1
          ],
          "expected": [
            0.5,
            0.5
          ]
        },
        {
          "args": [
            [
              0,
              1.0986122886681098
            ],
            1
          ],
          "expected": [
            0.25,
            0.75
          ]
        },
        {
          "args": [
            [
              0,
              2
            ],
            2
          ],
          "expected": [
            0.2689414213699951,
            0.7310585786300049
          ]
        },
        {
          "args": [
            [],
            1
          ],
          "expected": []
        },
        {
          "args": [
            [
              1
            ],
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              true
            ],
            1
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-03",
      "title": "Чанки с перекрытием",
      "statement": "Разбей text через str.split() на слова. Первый чанк начинается с 0; после каждого непоследнего сдвиг size-overlap. Добавив чанк, дошедший до конца текста, остановись: дублирующего хвоста не создавать. Внутри чанка слова соединены одним пробелом. size — int>0, overlap — int и 0≤overlap<size; bool недопустим, иначе ValueError. Пустой/пробельный текст даёт [].",
      "example": "(\"a b c d e\", 3, 1) → [\"a b c\", \"c d e\"]",
      "entry": "chunk_words",
      "starter": "def chunk_words(text: str, size: int, overlap: int) -> list[str]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            "a b c d e",
            3,
            1
          ],
          "expected": [
            "a b c",
            "c d e"
          ]
        },
        {
          "args": [
            "a b c d",
            3,
            1
          ],
          "expected": [
            "a b c",
            "c d"
          ]
        },
        {
          "args": [
            " a\n b ",
            2,
            0
          ],
          "expected": [
            "a b"
          ]
        },
        {
          "args": [
            "   ",
            2,
            0
          ],
          "expected": []
        },
        {
          "args": [
            "a",
            0,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            "a",
            2,
            2
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-04",
      "title": "Точный векторный поиск",
      "statement": "Верни до k ID по убыванию cosine similarity, при равенстве — лексикографически по ID. Нулевой query или документ имеет similarity=0. query должен иметь положительную размерность; все векторы той же длины и состоят из конечных чисел (без bool). k — int≥0, иначе ValueError. documents может быть пустым; k=0 возвращает []. Вход не менять.",
      "example": "([1, 0], {\"b\": [1, 0], \"a\": [1, 0], \"c\": [0, 1]}, 2) → [\"a\", \"b\"]",
      "entry": "cosine_rank",
      "starter": "def cosine_rank(query: list[float], documents: dict[str, list[float]], k: int) -> list[str]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1,
              0
            ],
            {
              "b": [
                1,
                0
              ],
              "a": [
                1,
                0
              ],
              "c": [
                0,
                1
              ]
            },
            2
          ],
          "expected": [
            "a",
            "b"
          ]
        },
        {
          "args": [
            [
              0,
              0
            ],
            {
              "z": [
                1,
                1
              ],
              "a": [
                0,
                0
              ]
            },
            5
          ],
          "expected": [
            "a",
            "z"
          ]
        },
        {
          "args": [
            [
              1,
              0
            ],
            {
              "a": [
                -1,
                0
              ],
              "b": [
                0,
                0
              ]
            },
            2
          ],
          "expected": [
            "b",
            "a"
          ]
        },
        {
          "args": [
            [
              1
            ],
            {},
            2
          ],
          "expected": []
        },
        {
          "args": [
            [
              1
            ],
            {
              "a": [
                1,
                2
              ]
            },
            2
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1
            ],
            {},
            -1
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-05",
      "title": "Reciprocal Rank Fusion",
      "statement": "Объедини списки ID по сумме 1/(c+rank). Ранги начинаются с 1. Дубли внутри каждого списка сначала удаляются с сохранением первого появления, потом назначаются ранги. При равном score сортируй по ID. c — int>0, limit — int≥0, bool недопустим. Иначе ValueError. Верни до limit ID; пустые списки допустимы.",
      "example": "([[\"a\", \"b\"], [\"b\", \"c\"]], 60, 2) → [\"b\", \"a\"]",
      "entry": "rrf",
      "starter": "def rrf(rankings: list[list[str]], c: int, limit: int) -> list[str]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              [
                "a",
                "b"
              ],
              [
                "b",
                "c"
              ]
            ],
            60,
            2
          ],
          "expected": [
            "b",
            "a"
          ]
        },
        {
          "args": [
            [
              [
                "b",
                "b",
                "a"
              ],
              [
                "a"
              ]
            ],
            1,
            3
          ],
          "expected": [
            "a",
            "b"
          ]
        },
        {
          "args": [
            [],
            60,
            2
          ],
          "expected": []
        },
        {
          "args": [
            [
              [
                "z"
              ],
              [
                "a"
              ]
            ],
            60,
            3
          ],
          "expected": [
            "a",
            "z"
          ]
        },
        {
          "args": [
            [
              [
                "a"
              ]
            ],
            0,
            2
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              [
                "a"
              ]
            ],
            60,
            0
          ],
          "expected": []
        }
      ]
    },
    {
      "id": "LLM-06",
      "title": "Метрики retrieval",
      "statement": "Удали дубли ranked с сохранением порядка, возьми первые k. relevant — множество ID независимо от дублей. Верни precision, recall, rr. precision=число найденных релевантных/k, даже если результатов меньше k. recall=найденные/число relevant, при пустом relevant — 0. rr=1/позиция первого релевантного в top-k, либо 0. k — int>0, иначе ValueError; bool недопустим. Возвращаемые ключи ровно precision, recall, rr.",
      "example": "([\"x\", \"a\", \"b\"], [\"a\", \"b\", \"c\"], 2) → {\"precision\": 0.5, \"recall\": 1/3, \"rr\": 0.5}",
      "entry": "retrieval_metrics",
      "starter": "def retrieval_metrics(ranked: list[str], relevant: list[str], k: int) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              "x",
              "a",
              "b"
            ],
            [
              "a",
              "b",
              "c"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 0.3333333333333333,
            "rr": 0.5
          }
        },
        {
          "args": [
            [
              "a",
              "a",
              "b"
            ],
            [
              "a",
              "b"
            ],
            2
          ],
          "expected": {
            "precision": 1.0,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [
              "a"
            ],
            [
              "a"
            ],
            2
          ],
          "expected": {
            "precision": 0.5,
            "recall": 1.0,
            "rr": 1.0
          }
        },
        {
          "args": [
            [],
            [],
            2
          ],
          "expected": {
            "precision": 0.0,
            "recall": 0.0,
            "rr": 0.0
          }
        },
        {
          "args": [
            [],
            [],
            0
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-07",
      "title": "Exact match и token F1",
      "statement": "Нормализация: lower(), затем токены re.findall(r\"[^\\W_]+\", text.lower()) в Unicode; нормализованный текст — токены через пробел. exact_match=1.0 при равенстве нормализованных текстов. F1 — гармоническое среднее precision/recall по мультимножествам токенов. Оба пусты → F1=1; один пуст → 0. Верни ровно exact_match и f1. Синонимы, стемминг и числовой смысл не учитывать.",
      "example": "(\"Кот, кот!\", \"кот\") → {\"exact_match\": 0.0, \"f1\": 2/3}",
      "entry": "answer_scores",
      "starter": "def answer_scores(prediction: str, reference: str) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            "Кот, кот!",
            "кот"
          ],
          "expected": {
            "exact_match": 0.0,
            "f1": 0.6666666666666666
          }
        },
        {
          "args": [
            " Ответ: 42! ",
            "ответ 42"
          ],
          "expected": {
            "exact_match": 1.0,
            "f1": 1.0
          }
        },
        {
          "args": [
            "",
            ""
          ],
          "expected": {
            "exact_match": 1.0,
            "f1": 1.0
          }
        },
        {
          "args": [
            "а",
            ""
          ],
          "expected": {
            "exact_match": 0.0,
            "f1": 0.0
          }
        },
        {
          "args": [
            "a_b",
            "a b"
          ],
          "expected": {
            "exact_match": 1.0,
            "f1": 1.0
          }
        }
      ]
    },
    {
      "id": "LLM-08",
      "title": "Разбиение без утечки",
      "statement": "Каждая строка содержит ровно id и group — строки. Все id уникальны; неправильная структура/дубль id → ValueError. Верни train и test как списки ID в исходном порядке: group в test_groups → test, иначе train. Неизвестные группы в test_groups допустимы, их повторы несущественны. Не меняй вход. Эта задача проверяет назначение групп, а не случайный выбор долей.",
      "example": "([{\"id\":\"a\",\"group\":\"d1\"},{\"id\":\"b\",\"group\":\"d2\"}], [\"d2\"]) → {\"train\":[\"a\"],\"test\":[\"b\"]}",
      "entry": "group_split",
      "starter": "def group_split(rows: list[dict], test_groups: list[str]) -> dict[str, list[str]]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              {
                "id": "a",
                "group": "d1"
              },
              {
                "id": "b",
                "group": "d2"
              },
              {
                "id": "c",
                "group": "d1"
              }
            ],
            [
              "d1"
            ]
          ],
          "expected": {
            "train": [
              "b"
            ],
            "test": [
              "a",
              "c"
            ]
          }
        },
        {
          "args": [
            [],
            [
              "d"
            ]
          ],
          "expected": {
            "train": [],
            "test": []
          }
        },
        {
          "args": [
            [
              {
                "id": "a",
                "group": "d"
              }
            ],
            []
          ],
          "expected": {
            "train": [
              "a"
            ],
            "test": []
          }
        },
        {
          "args": [
            [
              {
                "id": "a",
                "group": "d"
              },
              {
                "id": "a",
                "group": "e"
              }
            ],
            []
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              {
                "id": "a"
              }
            ],
            []
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-09",
      "title": "Paired bootstrap",
      "statement": "deltas — непустой список конечных попарных разностей; n_samples — int>0 (без bool), seed — int. Иначе ValueError. Используй rng=random.Random(seed). Для каждого bootstrap-повтора выбирай len(deltas) индексов через rng.randrange(len(deltas)), вычисляй среднее. Отсортируй средние. low/high — nearest-rank 2.5% и 97.5%: индекс max(0,ceil(p*n_samples)-1). mean — среднее исходных deltas. Верни mean, low, high. Это учебный percentile-интервал, не готовая проверка статистической значимости.",
      "example": "([1, 1], 100, 42) → {\"mean\":1.0,\"low\":1.0,\"high\":1.0}",
      "entry": "paired_bootstrap",
      "starter": "def paired_bootstrap(deltas: list[float], n_samples: int, seed: int) -> dict[str, float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1,
              1
            ],
            100,
            42
          ],
          "expected": {
            "mean": 1.0,
            "low": 1.0,
            "high": 1.0
          }
        },
        {
          "args": [
            [
              -1,
              1,
              2
            ],
            200,
            42
          ],
          "expected": {
            "mean": 0.6666666666666666,
            "low": -1.0,
            "high": 2.0
          }
        },
        {
          "args": [
            [
              0
            ],
            5,
            0
          ],
          "expected": {
            "mean": 0.0,
            "low": 0.0,
            "high": 0.0
          }
        },
        {
          "args": [
            [],
            10,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1
            ],
            0,
            0
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-10",
      "title": "Валидация tool call",
      "statement": "call имеет ровно поля name (str) и arguments (dict). tools отображает имя tool в словарь аргумент→тип; допустимы типы str, int, bool. Все перечисленные аргументы обязательны; лишние запрещены. Тип проверяется точно: bool не int. Неизвестный tool/тип схемы, неверные поля/типы → ValueError. При успехе верни новый словарь с теми же name и arguments (копия). Ничего не выполняй, не используй eval.",
      "example": "({\"name\":\"search\",\"arguments\":{\"q\":\"RAG\"}}, {\"search\":{\"q\":\"str\"}}) → тот же вызов",
      "entry": "validate_tool_call",
      "starter": "def validate_tool_call(call: dict, tools: dict[str, dict[str, str]]) -> dict:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            {
              "name": "search",
              "arguments": {
                "q": "RAG"
              }
            },
            {
              "search": {
                "q": "str"
              }
            }
          ],
          "expected": {
            "name": "search",
            "arguments": {
              "q": "RAG"
            }
          }
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {}
            },
            {}
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "n": true
              }
            },
            {
              "x": {
                "n": "int"
              }
            }
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "q": "a",
                "extra": 1
              }
            },
            {
              "x": {
                "q": "str"
              }
            }
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "ok": false
              }
            },
            {
              "x": {
                "ok": "bool"
              }
            }
          ],
          "expected": {
            "name": "x",
            "arguments": {
              "ok": false
            }
          }
        }
      ]
    },
    {
      "id": "LLM-11",
      "title": "Политика повторов",
      "statement": "Для HTTP 429, 500, 502, 503, 504 верни min(cap, base*2**(attempt-1)); для остальных HTTP статусов 100..599 — None. attempt — целый номер неудачной попытки ≥1; base/cap — конечные числа >0; status — int100..599, bool нигде не допускается. Иначе ValueError. При очень большом attempt не допускай переполнения. Функция ничего не ждёт и не делает запросов. Retry-After и jitter вне её контракта.",
      "example": "(429, 3, 0.5, 5) → 2.0",
      "entry": "retry_delay",
      "starter": "def retry_delay(status: int, attempt: int, base: float, cap: float) -> float | None:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            429,
            3,
            0.5,
            5
          ],
          "expected": 2.0
        },
        {
          "args": [
            503,
            10,
            1,
            8
          ],
          "expected": 8.0
        },
        {
          "args": [
            401,
            1,
            1,
            8
          ],
          "expected": null
        },
        {
          "args": [
            200,
            1,
            1,
            8
          ],
          "expected": null
        },
        {
          "args": [
            500,
            1000000,
            1,
            8
          ],
          "expected": 8.0
        },
        {
          "args": [
            500,
            0,
            1,
            8
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-12",
      "title": "Ключ кэша",
      "statement": "Верни SHA-256 hex UTF-8 JSON-объекта с ключами model, prompt, config. Сериализация json.dumps(..., ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False). Порядок ключей config не должен влиять. model и prompt — строки, config — dict с JSON-совместимыми значениями/строковыми ключами; несоответствие → ValueError. Не добавляй соль, дату или сетевой вызов. Версии индекса/прав должны передаваться вызывающим кодом в config.",
      "example": "cache_key(\"m\", \"привет\", {\"temperature\":0}) → стабильный 64-символьный hex",
      "entry": "cache_key",
      "starter": "def cache_key(model: str, prompt: str, config: dict) -> str:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            "m",
            "привет",
            {
              "temperature": 0
            }
          ],
          "expected": "cf2370011c15873b96d6c876412cbb33d5bf44dee7377a57b7efa09bb20af8f4"
        },
        {
          "args": [
            "m",
            "x",
            {
              "b": 2,
              "a": 1
            }
          ],
          "expected": "85b8cbf4a301165c245bf08ec7013bdd9d922fbce884285e4489c4a2fd4ca19b"
        },
        {
          "args": [
            "m2",
            "x",
            {}
          ],
          "expected": "9bcf694900f021fee1cba1fa4f0d5cb670b6ce1450228fe88e626f8377d62971"
        },
        {
          "args": [
            "m",
            "",
            {}
          ],
          "expected": "62bd19d414ecabb684ec09e21d17b22667f663b6b948474b33f256b434026aa2"
        },
        {
          "args": [
            1,
            "x",
            {}
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-13",
      "title": "p50 и p95 latency",
      "statement": "Непустые values — конечные числа ≥0, p — конечное число 0<p≤100; bool не допускается. Иначе ValueError. Верни sorted(values)[ceil(p/100*n)-1]. Не меняй вход. Это nearest-rank, без линейной интерполяции.",
      "example": "([1, 2, 3, 4, 100], 95) → 100",
      "entry": "percentile",
      "starter": "def percentile(values: list[float], p: float) -> float:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1,
              2,
              3,
              4,
              100
            ],
            95
          ],
          "expected": 100
        },
        {
          "args": [
            [
              1,
              2,
              3,
              4,
              100
            ],
            50
          ],
          "expected": 3
        },
        {
          "args": [
            [
              7
            ],
            1
          ],
          "expected": 7
        },
        {
          "args": [
            [
              5,
              1,
              3,
              2
            ],
            50
          ],
          "expected": 2
        },
        {
          "args": [
            [],
            50
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1
            ],
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              -1,
              2
            ],
            50
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-14",
      "title": "SQL-отчёт по моделям",
      "statement": "Используй sqlite3 и параметризованную вставку в память. Строки содержат ровно model(str), input_tokens(int≥0), output_tokens(int≥0), ok(bool). Неверные поля/типы → ValueError. SQL-агрегацией GROUP BY model посчитай requests, success_rate (число успешных/requests), total_tokens. Верни список словарей с model и этими тремя полями по model ASC. [] → []. Не собирай агрегацию Python-циклом; это проверяется на ревью, а тесты проверяют результат.",
      "example": "две строки модели m с ok=True/False и токенами 2+3, 1+4 → requests=2, success_rate=0.5, total_tokens=10",
      "entry": "model_report",
      "starter": "def model_report(rows: list[dict]) -> list[dict]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              {
                "model": "m",
                "input_tokens": 2,
                "output_tokens": 3,
                "ok": true
              },
              {
                "model": "m",
                "input_tokens": 1,
                "output_tokens": 4,
                "ok": false
              }
            ]
          ],
          "expected": [
            {
              "model": "m",
              "requests": 2,
              "success_rate": 0.5,
              "total_tokens": 10
            }
          ]
        },
        {
          "args": [
            []
          ],
          "expected": []
        },
        {
          "args": [
            [
              {
                "model": "z",
                "input_tokens": 0,
                "output_tokens": 0,
                "ok": false
              },
              {
                "model": "a",
                "input_tokens": 1,
                "output_tokens": 1,
                "ok": true
              }
            ]
          ],
          "expected": [
            {
              "model": "a",
              "requests": 1,
              "success_rate": 1.0,
              "total_tokens": 2
            },
            {
              "model": "z",
              "requests": 1,
              "success_rate": 0.0,
              "total_tokens": 0
            }
          ]
        },
        {
          "args": [
            [
              {
                "model": "m",
                "input_tokens": -1,
                "output_tokens": 0,
                "ok": true
              }
            ]
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-15",
      "title": "Размер адаптера LoRA",
      "statement": "Для одной матрицы без bias верни base=d_in*d_out, trainable=rank*(d_in+d_out), ratio=trainable/base. Все аргументы — положительные int (без bool), rank≤min(d_in,d_out); иначе ValueError. Это не оценка всех параметров реальной модели.",
      "example": "(100, 200, 4) → {\"base\":20000,\"trainable\":1200,\"ratio\":0.06}",
      "entry": "lora_parameters",
      "starter": "def lora_parameters(d_in: int, d_out: int, rank: int) -> dict:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            100,
            200,
            4
          ],
          "expected": {
            "base": 20000,
            "trainable": 1200,
            "ratio": 0.06
          }
        },
        {
          "args": [
            2,
            2,
            2
          ],
          "expected": {
            "base": 4,
            "trainable": 8,
            "ratio": 2.0
          }
        },
        {
          "args": [
            1,
            1,
            1
          ],
          "expected": {
            "base": 1,
            "trainable": 2,
            "ratio": 2.0
          }
        },
        {
          "args": [
            2,
            3,
            4
          ],
          "error": "ValueError"
        },
        {
          "args": [
            0,
            2,
            1
          ],
          "error": "ValueError"
        }
      ]
    },
    {
      "id": "LLM-16",
      "title": "Quality gate релиза",
      "statement": "Оба словаря содержат ровно quality (число 0..1) и p95_ms (число≥0). min_quality — 0..1, max_p95≥0; все числа конечны и без bool, иначе ValueError. Верни True только если candidate.quality≥max(baseline.quality,min_quality) и candidate.p95_ms≤max_p95. Равенство порогу проходит. baseline.p95_ms используется для валидации входа, но не задаёт порог. Это gate качества/latency, а не полный production release.",
      "example": "({\"quality\":0.8,\"p95_ms\":100},{\"quality\":0.85,\"p95_ms\":120},0.8,150) → True",
      "entry": "release_gate",
      "starter": "def release_gate(baseline: dict, candidate: dict, min_quality: float, max_p95: float) -> bool:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.85,
              "p95_ms": 120
            },
            0.8,
            150
          ],
          "expected": true
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.79,
              "p95_ms": 50
            },
            0.7,
            150
          ],
          "expected": false
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.8,
              "p95_ms": 150
            },
            0.8,
            150
          ],
          "expected": true
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.9,
              "p95_ms": 151
            },
            0.8,
            150
          ],
          "expected": false
        },
        {
          "args": [
            {
              "quality": 2,
              "p95_ms": 1
            },
            {
              "quality": 0.9,
              "p95_ms": 1
            },
            0.8,
            10
          ],
          "error": "ValueError"
        }
      ]
    }
  ]
}
