{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-11",
      "title": "Политика повторов",
      "statement": "Для HTTP 429, 500, 502, 503, 504 верни min(cap, base*2**(attempt-1)); для остальных HTTP статусов 100..599 — None. attempt — целый номер неудачной попытки ≥1; base/cap — конечные числа >0; status — int100..599, bool нигде не допускается. Иначе ValueError. При очень большом attempt не допускай переполнения. Функция ничего не ждёт и не делает запросов. Retry-After и jitter вне её контракта.",
      "example": "(429, 3, 0.5, 5) → 2.0",
      "entry": "retry_delay",
      "starter": "def retry_delay(status: int, attempt: int, base: float, cap: float) -> float | None:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            429,
            3,
            0.5,
            5
          ],
          "expected": 2.0
        },
        {
          "args": [
            503,
            10,
            1,
            8
          ],
          "expected": 8.0
        },
        {
          "args": [
            401,
            1,
            1,
            8
          ],
          "expected": null
        },
        {
          "args": [
            200,
            1,
            1,
            8
          ],
          "expected": null
        },
        {
          "args": [
            500,
            1000000,
            1,
            8
          ],
          "expected": 8.0
        },
        {
          "args": [
            500,
            0,
            1,
            8
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "medium",
      "lesson": "11 API, повторы и идемпотентность.md",
      "editorial": {
        "explanation": "Для временных ошибок удваивай задержку до достижения потолка. Цикл завершается сразу при достижении cap даже для очень большого номера попытки.",
        "code": "import math\n\ndef retry_delay(status, attempt, base, cap):\n    if (type(status) is not int or not 100 <= status <= 599\n            or type(attempt) is not int or attempt < 1\n            or any(type(x) not in (int, float) or not math.isfinite(x)\n                   or x <= 0 for x in (base, cap))):\n        raise ValueError(\"Некорректные параметры повтора\")\n    if status not in {429, 500, 502, 503, 504}:\n        return None\n    delay = min(base, cap)\n    for _ in range(attempt - 1):\n        if delay >= cap:\n            break\n        delay = min(2 * delay, cap)\n    return delay"
      }
    }
  ]
}
