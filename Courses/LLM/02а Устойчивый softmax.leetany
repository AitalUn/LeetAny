{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-02",
      "title": "Устойчивый softmax",
      "statement": "Верни вероятности softmax(logits/temperature). Используй численно устойчивое вычисление. [] даёт []; temperature должен быть конечным числом >0, logits должны быть конечными числами; bool не считается числом. Иначе ValueError. Сумма вероятностей близка к 1, исходный список не меняется. Абсолютная погрешность тестов 1e-8.",
      "example": "([1000, 1000], 1) → [0.5, 0.5]",
      "entry": "softmax",
      "starter": "def softmax(logits: list[float], temperature: float) -> list[float]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1000,
              1000
            ],
            1
          ],
          "expected": [
            0.5,
            0.5
          ]
        },
        {
          "args": [
            [
              0,
              1.0986122886681098
            ],
            1
          ],
          "expected": [
            0.25,
            0.75
          ]
        },
        {
          "args": [
            [
              0,
              2
            ],
            2
          ],
          "expected": [
            0.2689414213699951,
            0.7310585786300049
          ]
        },
        {
          "args": [
            [],
            1
          ],
          "expected": []
        },
        {
          "args": [
            [
              1
            ],
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              true
            ],
            1
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "easy",
      "lesson": "02 Декодирование и промпты.md",
      "editorial": {
        "explanation": "Вычитание максимального логита сохраняет отношения вероятностей. Наибольший вес тогда равен единице, и экспоненты не переполняются.",
        "code": "import math\n\ndef softmax(logits, temperature):\n    if any(type(x) not in (int, float) or not math.isfinite(x)\n           for x in [temperature, *logits]) or temperature <= 0:\n        raise ValueError(\"Проверь температуру и логиты\")\n    if not logits:\n        return []\n    peak = max(logits)\n    weights = [math.exp((x - peak) / temperature) for x in logits]\n    total = sum(weights)\n    return [w / total for w in weights]"
      }
    }
  ]
}
