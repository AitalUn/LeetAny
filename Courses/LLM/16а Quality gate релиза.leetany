{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-16",
      "title": "Quality gate релиза",
      "statement": "Оба словаря содержат ровно quality (число 0..1) и p95_ms (число≥0). min_quality — 0..1, max_p95≥0; все числа конечны и без bool, иначе ValueError. Верни True только если candidate.quality≥max(baseline.quality,min_quality) и candidate.p95_ms≤max_p95. Равенство порогу проходит. baseline.p95_ms используется для валидации входа, но не задаёт порог. Это gate качества/latency, а не полный production release.",
      "example": "({\"quality\":0.8,\"p95_ms\":100},{\"quality\":0.85,\"p95_ms\":120},0.8,150) → True",
      "entry": "release_gate",
      "starter": "def release_gate(baseline: dict, candidate: dict, min_quality: float, max_p95: float) -> bool:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.85,
              "p95_ms": 120
            },
            0.8,
            150
          ],
          "expected": true
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.79,
              "p95_ms": 50
            },
            0.7,
            150
          ],
          "expected": false
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.8,
              "p95_ms": 150
            },
            0.8,
            150
          ],
          "expected": true
        },
        {
          "args": [
            {
              "quality": 0.8,
              "p95_ms": 100
            },
            {
              "quality": 0.9,
              "p95_ms": 151
            },
            0.8,
            150
          ],
          "expected": false
        },
        {
          "args": [
            {
              "quality": 2,
              "p95_ms": 1
            },
            {
              "quality": 0.9,
              "p95_ms": 1
            },
            0.8,
            10
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "medium",
      "lesson": "16 MLOps, тестирование и выпуск.md",
      "editorial": {
        "explanation": "Кандидат должен пройти сразу три проверки: сохранить качество базовой модели, достигнуть заданного минимума качества и уложиться в лимит задержки.",
        "code": "import math\n\ndef release_gate(baseline, candidate, min_quality, max_p95):\n    def nonnegative(x):\n        return type(x) in (int, float) and math.isfinite(x) and x >= 0\n    for metrics in (baseline, candidate):\n        if (not isinstance(metrics, dict) or set(metrics) != {\"quality\", \"p95_ms\"}\n                or not nonnegative(metrics[\"quality\"]) or metrics[\"quality\"] > 1\n                or not nonnegative(metrics[\"p95_ms\"])):\n            raise ValueError(\"Некорректные метрики\")\n    if not nonnegative(min_quality) or min_quality > 1 or not nonnegative(max_p95):\n        raise ValueError(\"Некорректные пороги\")\n    return (candidate[\"quality\"] >= max(baseline[\"quality\"], min_quality)\n            and candidate[\"p95_ms\"] <= max_p95)"
      }
    }
  ]
}
