{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-14",
      "title": "SQL-отчёт по моделям",
      "statement": "Используй sqlite3 и параметризованную вставку в память. Строки содержат ровно model(str), input_tokens(int≥0), output_tokens(int≥0), ok(bool). Неверные поля/типы → ValueError. SQL-агрегацией GROUP BY model посчитай requests, success_rate (число успешных/requests), total_tokens. Верни список словарей с model и этими тремя полями по model ASC. [] → []. Не собирай агрегацию Python-циклом; это проверяется на ревью, а тесты проверяют результат.",
      "example": "две строки модели m с ok=True/False и токенами 2+3, 1+4 → requests=2, success_rate=0.5, total_tokens=10",
      "entry": "model_report",
      "starter": "def model_report(rows: list[dict]) -> list[dict]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              {
                "model": "m",
                "input_tokens": 2,
                "output_tokens": 3,
                "ok": true
              },
              {
                "model": "m",
                "input_tokens": 1,
                "output_tokens": 4,
                "ok": false
              }
            ]
          ],
          "expected": [
            {
              "model": "m",
              "requests": 2,
              "success_rate": 0.5,
              "total_tokens": 10
            }
          ]
        },
        {
          "args": [
            []
          ],
          "expected": []
        },
        {
          "args": [
            [
              {
                "model": "z",
                "input_tokens": 0,
                "output_tokens": 0,
                "ok": false
              },
              {
                "model": "a",
                "input_tokens": 1,
                "output_tokens": 1,
                "ok": true
              }
            ]
          ],
          "expected": [
            {
              "model": "a",
              "requests": 1,
              "success_rate": 1.0,
              "total_tokens": 2
            },
            {
              "model": "z",
              "requests": 1,
              "success_rate": 0.0,
              "total_tokens": 0
            }
          ]
        },
        {
          "args": [
            [
              {
                "model": "m",
                "input_tokens": -1,
                "output_tokens": 0,
                "ok": true
              }
            ]
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "medium",
      "lesson": "14 SQL и журнал экспериментов.md",
      "editorial": {
        "explanation": "Запиши валидные события в SQLite через параметры. Для каждой модели GROUP BY собирает число запросов, среднее индикатора успеха и сумму токенов.",
        "code": "import sqlite3\nfrom contextlib import closing\n\ndef model_report(rows):\n    with closing(sqlite3.connect(\":memory:\")) as db:\n        db.row_factory = sqlite3.Row\n        db.execute(\"CREATE TABLE events (model TEXT, inp INTEGER, outp INTEGER, ok INTEGER)\")\n        for row in rows:\n            if not isinstance(row, dict) or set(row) != {\"model\", \"input_tokens\", \"output_tokens\", \"ok\"}:\n                raise ValueError(\"Неверные поля\")\n            if (not isinstance(row[\"model\"], str) or type(row[\"ok\"]) is not bool\n                    or any(type(row[k]) is not int or row[k] < 0\n                           for k in (\"input_tokens\", \"output_tokens\"))):\n                raise ValueError(\"Неверное значение\")\n            db.execute(\"INSERT INTO events VALUES (?, ?, ?, ?)\",\n                       (row[\"model\"], row[\"input_tokens\"], row[\"output_tokens\"], row[\"ok\"]))\n        query = \"\"\"SELECT model, COUNT(*) AS requests, AVG(ok) AS success_rate,\n                          SUM(inp + outp) AS total_tokens\n                   FROM events GROUP BY model ORDER BY model\"\"\"\n        return [dict(row) for row in db.execute(query)]"
      }
    }
  ]
}
