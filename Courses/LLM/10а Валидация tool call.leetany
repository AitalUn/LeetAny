{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-10",
      "title": "Валидация tool call",
      "statement": "call имеет ровно поля name (str) и arguments (dict). tools отображает имя tool в словарь аргумент→тип; допустимы типы str, int, bool. Все перечисленные аргументы обязательны; лишние запрещены. Тип проверяется точно: bool не int. Неизвестный tool/тип схемы, неверные поля/типы → ValueError. При успехе верни новый словарь с теми же name и arguments (копия). Ничего не выполняй, не используй eval.",
      "example": "({\"name\":\"search\",\"arguments\":{\"q\":\"RAG\"}}, {\"search\":{\"q\":\"str\"}}) → тот же вызов",
      "entry": "validate_tool_call",
      "starter": "def validate_tool_call(call: dict, tools: dict[str, dict[str, str]]) -> dict:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            {
              "name": "search",
              "arguments": {
                "q": "RAG"
              }
            },
            {
              "search": {
                "q": "str"
              }
            }
          ],
          "expected": {
            "name": "search",
            "arguments": {
              "q": "RAG"
            }
          }
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {}
            },
            {}
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "n": true
              }
            },
            {
              "x": {
                "n": "int"
              }
            }
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "q": "a",
                "extra": 1
              }
            },
            {
              "x": {
                "q": "str"
              }
            }
          ],
          "error": "ValueError"
        },
        {
          "args": [
            {
              "name": "x",
              "arguments": {
                "ok": false
              }
            },
            {
              "x": {
                "ok": "bool"
              }
            }
          ],
          "expected": {
            "name": "x",
            "arguments": {
              "ok": false
            }
          }
        }
      ],
      "difficulty": "medium",
      "lesson": "10 Агенты, tools и MCP.md",
      "editorial": {
        "explanation": "Имя инструмента выбирает схему. Сначала сравни наборы ключей, затем проверь точный тип каждого значения. Это исключает True там, где инструмент ожидает int.",
        "code": "def validate_tool_call(call, tools):\n    if not isinstance(call, dict) or set(call) != {\"name\", \"arguments\"}:\n        raise ValueError(\"Неверный формат вызова\")\n    name, args = call[\"name\"], call[\"arguments\"]\n    if not isinstance(name, str) or not isinstance(args, dict) or name not in tools:\n        raise ValueError(\"Неизвестный инструмент или неверные аргументы\")\n    schema = tools[name]\n    types = {\"str\": str, \"int\": int, \"bool\": bool}\n    if not isinstance(schema, dict) or set(schema) != set(args):\n        raise ValueError(\"Поля не соответствуют схеме\")\n    for key, kind in schema.items():\n        if not isinstance(kind, str) or type(args[key]) is not types.get(kind):\n            raise ValueError(\"Неверный тип аргумента\")\n    return {\"name\": name, \"arguments\": args.copy()}"
      }
    }
  ]
}
