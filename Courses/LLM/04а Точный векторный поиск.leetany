{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-04",
      "title": "Точный векторный поиск",
      "statement": "Верни до k ID по убыванию cosine similarity, при равенстве — лексикографически по ID. Нулевой query или документ имеет similarity=0. query должен иметь положительную размерность; все векторы той же длины и состоят из конечных чисел (без bool). k — int≥0, иначе ValueError. documents может быть пустым; k=0 возвращает []. Вход не менять.",
      "example": "([1, 0], {\"b\": [1, 0], \"a\": [1, 0], \"c\": [0, 1]}, 2) → [\"a\", \"b\"]",
      "entry": "cosine_rank",
      "starter": "def cosine_rank(query: list[float], documents: dict[str, list[float]], k: int) -> list[str]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              1,
              0
            ],
            {
              "b": [
                1,
                0
              ],
              "a": [
                1,
                0
              ],
              "c": [
                0,
                1
              ]
            },
            2
          ],
          "expected": [
            "a",
            "b"
          ]
        },
        {
          "args": [
            [
              0,
              0
            ],
            {
              "z": [
                1,
                1
              ],
              "a": [
                0,
                0
              ]
            },
            5
          ],
          "expected": [
            "a",
            "z"
          ]
        },
        {
          "args": [
            [
              1,
              0
            ],
            {
              "a": [
                -1,
                0
              ],
              "b": [
                0,
                0
              ]
            },
            2
          ],
          "expected": [
            "b",
            "a"
          ]
        },
        {
          "args": [
            [
              1
            ],
            {},
            2
          ],
          "expected": []
        },
        {
          "args": [
            [
              1
            ],
            {
              "a": [
                1,
                2
              ]
            },
            2
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1
            ],
            {},
            -1
          ],
          "error": "ValueError"
        }
      ]
    }
  ]
}
