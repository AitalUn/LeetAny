{
  "version": 1,
  "exercises": [
    {
      "id": "LLM-01",
      "title": "Бюджет контекста",
      "statement": "token_counts — уже посчитанные количества токенов сообщений; индекс 0 — обязательное системное сообщение. Верни индекс 0 и самый длинный непрерывный суффикс остальных сообщений, помещающийся вместе с ним и reserve в limit. Иди от последнего сообщения назад; если очередное не помещается — остановись, более старые не подбирай. Не меняй вход. Если token_counts пуст — верни []. Числа — неотрицательные int (bool не принимается); отрицательные значения/не-int или обязательное сообщение+reserve>limit дают ValueError. Для пустого списка reserve>limit тоже ошибка.",
      "example": "([4, 6, 3, 2], 12, 2) → [0, 2, 3]",
      "entry": "select_context",
      "starter": "def select_context(token_counts: list[int], limit: int, reserve: int) -> list[int]:\n    raise NotImplementedError(\"Твоё решение\")",
      "tests": [
        {
          "args": [
            [
              4,
              6,
              3,
              2
            ],
            12,
            2
          ],
          "expected": [
            0,
            2,
            3
          ]
        },
        {
          "args": [
            [
              4,
              6,
              3,
              2
            ],
            20,
            2
          ],
          "expected": [
            0,
            1,
            2,
            3
          ]
        },
        {
          "args": [
            [],
            5,
            0
          ],
          "expected": []
        },
        {
          "args": [
            [
              4,
              10,
              2
            ],
            6,
            0
          ],
          "expected": [
            0,
            2
          ]
        },
        {
          "args": [
            [
              4,
              1
            ],
            3,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              1,
              -1
            ],
            10,
            0
          ],
          "error": "ValueError"
        },
        {
          "args": [
            [
              true
            ],
            5,
            0
          ],
          "error": "ValueError"
        }
      ],
      "difficulty": "easy",
      "lesson": "01 Как работает LLM.md",
      "editorial": {
        "explanation": "Сначала отложи резерв для ответа и системного сообщения. Затем набирай сообщения с конца до первого, которое не помещается: так сохранится непрерывный суффикс истории.",
        "code": "def select_context(token_counts, limit, reserve):\n    if any(type(x) is not int or x < 0 for x in [limit, reserve, *token_counts]):\n        raise ValueError(\"Ожидаются неотрицательные целые числа\")\n    remaining = limit - reserve - (token_counts[0] if token_counts else 0)\n    if remaining < 0:\n        raise ValueError(\"Не хватает места для обязательной части\")\n    if not token_counts:\n        return []\n    start = len(token_counts)\n    while start > 1 and token_counts[start - 1] <= remaining:\n        start -= 1\n        remaining -= token_counts[start]\n    return [0, *range(start, len(token_counts))]"
      }
    }
  ]
}
