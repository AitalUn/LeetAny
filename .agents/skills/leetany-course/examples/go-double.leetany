{
  "version": 1,
  "exercises": [
    {
      "id": "go-double",
      "language": "go",
      "parameters": [
        "n"
      ],
      "title": "Double an integer",
      "statement": "Return twice n. Inputs are integers between -1000 and 1000.",
      "entry": "doubleValue",
      "starter": "package main\n\nfunc doubleValue(n int64) int64 { return 0 }",
      "difficulty": "easy",
      "editorial": {
        "explanation": "Multiply the input by two.",
        "code": "package main\n\nfunc doubleValue(n int64) int64 { return 2 * n }"
      },
      "harness": "package main\nimport (\n    \"encoding/json\"\n    \"os\"\n)\nfunc main() {\n    var n int64\n    if err := json.NewDecoder(os.Stdin).Decode(&n); err != nil { panic(err) }\n    if err := json.NewEncoder(os.Stdout).Encode(map[string]int64{\"value\":doubleValue(n)}); err != nil { panic(err) }\n}\n",
      "tests": [
        {
          "args": [
            3
          ],
          "expected": 6
        },
        {
          "args": [
            0
          ],
          "expected": 0
        },
        {
          "args": [
            -4
          ],
          "expected": -8
        }
      ]
    }
  ]
}
